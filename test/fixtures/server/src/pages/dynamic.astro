---
Astro.cookies.set('visited', 'yes');
const name = Astro.url.searchParams.get('name') ?? 'world';
---
<html><head><title>Dynamic</title><meta name="description" content="Rendered on demand"></head>
<body><nav>Menu</nav><main><h1>Hello {name}</h1><p>Rendered at request time.</p></main></body></html>
