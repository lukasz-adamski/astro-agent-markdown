---
interface Props { title: string; description?: string; ignore?: boolean }
const { title, description, ignore } = Astro.props;
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
	</head>
	<body data-markdown-ignore={ignore ? '' : undefined}>
		<header><nav><a href="/">Home</a> <a href="/about/">About</a></nav></header>
		<main><slot /></main>
		<footer>© Example</footer>
	</body>
</html>
